{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/recruit",
      "destination": "/admissions",
      "permanent": true
    },
    {
      "source": "/recruit.html",
      "destination": "/admissions",
      "permanent": true
    },
    {
      "source": "/roster",
      "destination": "/si-roster",
      "permanent": true
    },
    {
      "source": "/roster.html",
      "destination": "/si-roster",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admissions",
      "destination": "/admissions.html"
    },
    {
      "source": "/si-roster/admin",
      "destination": "/SI-ROSTER/admin"
    },
    {
      "source": "/si-roster/admin/",
      "destination": "/SI-ROSTER/admin"
    },
    {
      "source": "/si-roster/admin.html",
      "destination": "/SI-ROSTER/admin"
    },
    {
      "source": "/roster/admin",
      "destination": "/SI-ROSTER/admin"
    },
    {
      "source": "/si-roster",
      "destination": "/SI-ROSTER"
    },
    {
      "source": "/si-roster/",
      "destination": "/SI-ROSTER"
    },
    {
      "source": "/si-roster/:path*",
      "destination": "/SI-ROSTER/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://prototype-sampling-fees-buy.trycloudflare.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://prototype-sampling-fees-buy.trycloudflare.com/uploads/:path*"
    }
  ]
}
